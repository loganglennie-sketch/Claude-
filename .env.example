# Copy this file to .env.local (never commit .env.local) and fill in the values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# From Supabase → Project Settings → API. Safe to show in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET. From Supabase → Project Settings → API ("secret" / service_role key).
# Only the app's server uses it. Never put it in code or share it.
SUPABASE_SECRET_KEY=

# SECRET. A long random string you generate once (e.g. 64 random characters).
# The server uses it to sign workers in after their PIN is checked.
APP_AUTH_SECRET=
